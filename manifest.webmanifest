{
  "id": "./",
  "name": "Mindlook",
  "short_name": "Mindlook",
  "description": "Mind map viewer for .xmind, FreeMind .mm, OPML and Markdown files. Parsed in your browser, nothing is uploaded.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3f4f6",
  "theme_color": "#1b1f24",
  "lang": "zh-CN",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/vnd.xmind.workbook": [".xmind"] } },
    { "action": "./", "accept": { "application/x-freemind": [".mm"] } },
    { "action": "./", "accept": { "text/x-opml": [".opml"] } },
    { "action": "./", "accept": { "text/markdown": [".md", ".markdown"] } },
    { "action": "./", "accept": { "text/plain": [".txt"] } }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
